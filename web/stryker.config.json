{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "best.ts",
    "connections.ts",
    "data.ts",
    "decode.ts",
    "fallback.ts",
    "fields.ts",
    "geometry.ts",
    "picks.ts",
    "reach.ts",
    "status.ts",
    "util.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "concurrency": 4,
  "inPlace": true
}
